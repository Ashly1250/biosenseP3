# Copia a biosense.env y rellena. Protegelo con: chmod 600 biosense.env
INPUT_MODE=mqtt
LOCAL_MQTT_USER=biosense
LOCAL_MQTT_PASS=CAMBIA_ESTA_CLAVE
TB_TOKEN=PEGA_AQUI_EL_ACCESS_TOKEN
# TB_HOST=eu.thingsboard.cloud
# TB_PORT=1883
# CLOUD_INTERVAL_S=60

# --- Alertas por Discord (Servidor > Editar canal > Integraciones > Webhooks > Copiar URL) ---
# DISCORD_WEBHOOK_URL=PEGA_AQUI_LA_URL_DEL_WEBHOOK
# ALERT_CONFIRM=2          # minutos seguidos para confirmar un cambio de estado
# ALERT_REMIND_MIN=30      # repetir el aviso si sigue en CRITICO
# NO_DATA_ALERT_S=300      # avisar si no llegan datos del TX
# TX_TZ=America/Bogota     # zona horaria en que esta ajustado el DS3231
